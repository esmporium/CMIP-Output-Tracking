# Secrets and machine-specific settings for the daily search job.
#
# Copy this to `.env` (which is git-ignored) and fill it in.
# Everything else the job needs is hard-coded in
# `scripts/drive-search-and-notifications.py`.

# --- The mail server to send notifications through -------------------------------
# Required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Address the notifications are sent from. Required.
EMAIL_SENDER=your-account@example.com

# Leave both blank for a mail relay running on the server itself
# (SMTP_HOST=localhost, SMTP_PORT=25, SMTP_STARTTLS=false), which needs no
# credentials because only the server can reach it.
SMTP_USERNAME=your-account@example.com

# For Gmail this must be an app password, not the account password, and 2-factor
# authentication has to be on before one can be issued.
# Google SHOWS it as four groups of four ("abcd efgh ijkl mnop") but it must be
# entered here as the 16 characters with NO SPACES. With the spaces left in,
# Gmail hangs up mid-login and the error looks like a network fault.
SMTP_PASSWORD=

# Set to "false" ONLY for a relay on localhost. Anything else leaves TLS on.
SMTP_STARTTLS=true

# --- Where downloaded data goes --------------------------------------------------
# Required by the download job (`make run-downloads`), which refuses to start
# without it. There is deliberately no default: the only one available would be
# somewhere inside this repository, and the first you would know of it is a `git
# status` full of netCDF, or a full disk on whichever volume the repository sits on.
#
# Not a secret, but machine-specific in the same way the mail settings are: a laptop
# and a shared server do not have the same data volume. On `cmip6-crunching` this is
# somewhere under /data; on a laptop, point it at a scratch directory.
#
# Files are laid out underneath it as
#   <dataset id, dots turned into slashes>/v<version>/<filename>
# which is DRS-shaped but is esmporium's own layout, not any project's real DRS.
DOWNLOAD_ROOT=/data/azehrung/cmip-data
