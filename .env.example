# Secrets and machine-specific settings for the daily search job.
#
# Copy this to `.env` (which is git-ignored) and fill it in.
# Everything else the job needs is hard-coded in
# `scripts/drive-search-and-notifications.py`.

# --- The mail server to send notifications through -------------------------------
# Required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Address the notifications are sent from. Required.
EMAIL_SENDER=your-account@example.com

# Leave both blank for a mail relay running on the server itself
# (SMTP_HOST=localhost, SMTP_PORT=25, SMTP_STARTTLS=false), which needs no
# credentials because only the server can reach it.
SMTP_USERNAME=your-account@example.com
SMTP_PASSWORD=

# Set to "false" ONLY for a relay on localhost. Anything else leaves TLS on.
SMTP_STARTTLS=true
